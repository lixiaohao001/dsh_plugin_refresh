{
  "name": "dsh_plugin_refresh",
  "version": "0.1.0",
  "description": "Automatic post-install plugin activation and hot refresh for DeepSeek Harness: check the installed composition, refresh it in-process, and reload replaced plugin modules so an installed plugin is usable without restarting DSH.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "cordis",
    "hot-reload",
    "hot-install",
    "no-restart",
    "plugin-manager",
    "plugin-refresh"
  ],
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "author": "lixiaohao001",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lixiaohao001/dsh_plugin_refresh.git"
  },
  "homepage": "https://github.com/lixiaohao001/dsh_plugin_refresh#readme",
  "bugs": {
    "url": "https://github.com/lixiaohao001/dsh_plugin_refresh/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
